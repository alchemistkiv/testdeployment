# Gizli anahtarlar .env.local'a yazılır (repoya girmez). Vercel'de de
# Environment Variables olarak girilir. Bu dosya sadece örnek/şablondur.

# Supabase (DB + realtime) — sonraki adımlarda gerekecek
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Mekan kaynağı: OpenStreetMap (Nominatim + Overpass) — anahtar/kart GEREKMEZ ($0).
# Bu yüzden burada Foursquare/harita anahtarı yok.

# DeepSeek (cümleyi ayıklayan + süzen beyin) — sunucu tarafı, gizli
# OpenAI-uyumlu API. Model: deepseek-chat (şu an deepseek-v4-flash).
DEEPSEEK_API_KEY=YOUR-DEEPSEEK-API-KEY
